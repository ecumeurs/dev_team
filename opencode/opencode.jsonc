{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llmward": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLMWard (LiteLLM + Presidio DLP)",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1"
      },
      "models": {
        "gpt-5.3-codex": {
          "name": "GPT-5.3 Codex (LLMWard)",
          "limit": {
            "context": 400000,
            "output": 128000
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol · flagship (LLMWard)",
          "provider": {
            "npm": "@ai-sdk/openai"
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra · balanced (LLMWard)",
          "provider": {
            "npm": "@ai-sdk/openai"
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna · economical (LLMWard)",
          "provider": {
            "npm": "@ai-sdk/openai"
          },
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "claude-sonnet": {
          "name": "Claude Sonnet 5 (LLMWard)",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "claude-opus": {
          "name": "Claude Opus 4.8 (LLMWard)",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "claude-haiku": {
          "name": "Claude Haiku 4.5 (LLMWard)",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 · 1M ctx (LLMWard)",
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        },
        "claude-fable": {
          "name": "Claude Fable 5 (LLMWard)",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        }
      }
    }
  },
  "model": "llmward/gpt-5.6-terra",
  "small_model": "llmward/gpt-5.6-luna",
  "agent": {
    "plan": {
      "model": "llmward/gpt-5.6-sol"
    },
    "build": {
      "model": "llmward/gpt-5.6-terra"
    }
  },
  "mcp": {
    "atd": {
      "type": "local",
      "command": ["/home/bastien/.local/bin/atd", "serve"],
      "enabled": true
    }
  },
  "disabled_providers": [
    "opencode",
    "minimax",
    "zai-coding-plan"
  ],
  "enabled_providers": [
    "llmward"
  ]
}
